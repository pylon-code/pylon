---
// The Pylon mark, traced from assets/prod/app-icon.icon/Assets/text.svg. Fills
// with currentColor so it can inherit hover and muted states from its context.
// Regenerate from that source rather than editing the path data here.
import { maskCounter } from "../lib/mask-counter";

interface Props {
  size?: number;
  class?: string;
}

const { size = 24, class: className } = Astro.props;

// The cutout mask needs an id unique to the page, since several marks render
// on every view and duplicate ids would collapse to whichever came first.
maskCounter.value += 1;
const maskId = `pylon-mark-cutout-${maskCounter.value}`;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 1024 1024"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <defs>
    <mask id={maskId}>
      <path
        d="M558 158.6 L795.1 295.4 A92 92 0 0 1 841.1 375.1 L841.1 648.9 A92 92 0 0 1 795.1 728.6 L558 865.4 A92 92 0 0 1 466 865.4 L228.9 728.6 A92 92 0 0 1 182.9 648.9 L182.9 375.1 A92 92 0 0 1 228.9 295.4 L466 158.6 A92 92 0 0 1 558 158.6 Z"
        fill="white"
      />
      <path
        d="M321.5 395 L512 285 L702.5 395 M321.5 395 L512 505 L702.5 395 M702.5 395 L702.5 615 L512 725 M321.5 395 L321.5 892 M512 505 L512 892"
        fill="none"
        stroke="black"
        stroke-width="41"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </mask>
  </defs>
  <path
    d="M558 158.6 L795.1 295.4 A92 92 0 0 1 841.1 375.1 L841.1 648.9 A92 92 0 0 1 795.1 728.6 L558 865.4 A92 92 0 0 1 466 865.4 L228.9 728.6 A92 92 0 0 1 182.9 648.9 L182.9 375.1 A92 92 0 0 1 228.9 295.4 L466 158.6 A92 92 0 0 1 558 158.6 Z"
    fill="currentColor"
    mask={`url(#${maskId})`}
  />
</svg>
